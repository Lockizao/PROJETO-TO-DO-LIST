# Copie este arquivo para .env e preencha com seus próprios valores.
# Nunca commite o .env real — ele contém credenciais.

# String de conexão do MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:senha@seu-cluster.mongodb.net/todo-db?retryWrites=true&w=majority

# Porta que o servidor irá rodar
PORT=5000

# Chave secreta usada para assinar os Tokens JWT (gere uma aleatória forte, ex: openssl rand -hex 32)
JWT_SECRET=troque-por-uma-string-aleatoria-longa
